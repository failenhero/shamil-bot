# Токен от @BotFather (/newbot). Обязателен.
BOT_TOKEN=

# ID чатов через запятую, где бот должен работать. Пусто = работать везде.
# Как узнать ID: оставьте пусто, добавьте бота в группу, напишите там что-нибудь
# и посмотрите `docker compose logs -f` — ID будет в строке [LOG] ВСЕ сообщения.
ALLOWED_CHAT_IDS=
